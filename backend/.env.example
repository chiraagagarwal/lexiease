# ==============================================================================
# LexiEase Backend Configuration Template
# ==============================================================================
# Copy this file to .env in production/local development and supply real values.
# NEVER commit real credentials, service account JSON files, or API keys.

# Application metadata
PROJECT_NAME="LexiEase API"

# Database connection URL (defaults to local SQLite for development)
# For production PostgreSQL: postgresql+psycopg2://user:password@localhost:5432/lexiease
DATABASE_URL=sqlite:///./lexiease.db

# Path to Firebase Admin SDK service account credentials JSON file
FIREBASE_CREDENTIALS_PATH=

# Testing mode (MUST be False in production)
# When True, allows mock token bypasses for isolated unit test runs
TESTING=False

# Google Gemini API key for accessible text simplification, translation, and assessment extraction
GEMINI_API_KEY=your_gemini_api_key_here

# Sarvam AI API subscription key for primary Indian language document OCR & TTS
SARVAM_API_KEY=your_sarvam_api_key_here

# Redis connection URL for asynchronous ARQ task processing (falls back to in-memory if Redis unavailable)
REDIS_URL=redis://localhost:6379/0

# Google Cloud credentials for Vision API OCR fallback
GOOGLE_APPLICATION_CREDENTIALS=
GCP_PROJECT_ID=

# Reverse proxy client IP resolution
# Set to True ONLY if running behind a trusted reverse proxy (e.g., Nginx, Traefik, Cloudflare)
TRUST_PROXY_HEADERS=False

# Sliding window rate limits (requests per minute)
RATE_LIMIT_GUEST_AI_PER_MINUTE=15
RATE_LIMIT_USER_AI_PER_MINUTE=60

# Allowed CORS origins (comma-separated, or * for open access)
# In production, set to your frontend domain: https://lexiease.example.com,https://lexiease.web.app
CORS_ORIGINS="*"
